{
  "name": "obsidian-excalidraw-layer-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript architecture-first Layer Manager package for Obsidian Excalidraw scripts",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:file": "node scripts/run-vitest-single-file.mjs",
    "test:watch": "vitest",
    "quality:ts": "npm run test:coverage && node build/run-ts-quality.mjs",
    "test:tree": "vitest run test/treeBuilder.acceptance.test.ts",
    "bench:tree": "vitest run test/treeBuilder.performance.test.ts",
    "bench:commands": "vitest run test/commands.performance.test.ts",
    "bench:runtime": "vitest run test/runtime.render-update.performance.test.ts",
    "bench:complexity": "vitest run test/performance.complexity-sentinel.test.ts",
    "arch": "depcruise --config .dependency-cruiser.cjs src",
    "deadcode": "knip",
    "verify:recovery": "node build/recoveryVerificationGate.mjs",
    "check:fast": "npm run lint && npm run typecheck && npm run typecheck:scripts",
    "check": "npm run verify:recovery && npm run deadcode && npm run test:coverage && node build/verifyDeploymentWorkflow.mjs",
    "check:full": "npm run check",
    "build": "node build/build.mjs",
    "sync:vault": "npm run check && node build/sync-to-vault.mjs",
    "bundle:and:sync": "npm run sync:vault",
    "docs:sync:ea": "node build/sync-excalidraw-automate-doc.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "knip": "^6.34.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "xstate": "^5.32.6"
  }
}
